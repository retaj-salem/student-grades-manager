<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.retaj.studentgrades.controller.ReportsController">
    <top><Label text="Reports" styleClass="title" BorderPane.alignment="CENTER" /></top>
    <center><TextArea fx:id="reportArea" editable="false" wrapText="true" prefWidth="650" prefHeight="360" /></center>
    <bottom>
        <HBox alignment="CENTER" spacing="15">
            <Button text="Generate Report" onAction="#generateReport" />
            <Button text="Back" onAction="#back" styleClass="secondary-button" />
        </HBox>
    </bottom>
</BorderPane>
