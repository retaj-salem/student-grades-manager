<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.retaj.studentgrades.controller.ViewStudentsController">
    <top><Label text="View Students" styleClass="title" BorderPane.alignment="CENTER" /></top>
    <center>
        <TableView fx:id="tableView" prefHeight="360" prefWidth="650">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="120" />
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="220" />
                <TableColumn fx:id="majorColumn" text="Major" prefWidth="180" />
                <TableColumn fx:id="gradeColumn" text="Grade" prefWidth="120" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="15">
            <Button text="Refresh" onAction="#refresh" />
            <Button text="Back" onAction="#back" styleClass="secondary-button" />
        </HBox>
    </bottom>
</BorderPane>
