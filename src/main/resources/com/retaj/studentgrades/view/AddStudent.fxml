<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.retaj.studentgrades.controller.AddStudentController">
    <center>
        <VBox alignment="CENTER" spacing="14" styleClass="card">
            <Label text="Add Student" styleClass="title" />
            <TextField fx:id="idField" promptText="Student ID" maxWidth="280" />
            <TextField fx:id="nameField" promptText="Student Name" maxWidth="280" />
            <TextField fx:id="majorField" promptText="Major" maxWidth="280" />
            <Button text="Save Student" onAction="#saveStudent" maxWidth="280" />
            <Button text="Back" onAction="#back" maxWidth="280" styleClass="secondary-button" />
            <Label fx:id="messageLabel" styleClass="message" />
        </VBox>
    </center>
</BorderPane>
